# ============================================================
# MediFlow Backend - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Required ----

# PostgreSQL connection string
DATABASE_URL=postgresql://mediflow:your_password@localhost:5432/mediflow

# Secret key for JWT token signing (generate a strong random key)
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-secret-key

# ---- Environment ----

# "development" or "production"
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins
# In production, set this to your frontend URL(s)
ALLOWED_HOSTS=["http://localhost:3000","http://localhost:8000"]

# ---- AI Services ----

# Groq API key for Llama 3.1 text AI (referral summaries, risk assessment)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI API key (optional, for Whisper API fallback)
OPENAI_API_KEY=

# Whisper model size: "base" (140MB, fast) or "large-v3" (3GB, most accurate)
WHISPER_MODEL=base

# ---- Email (SMTP) ----

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@mediflow.com
FROM_NAME=MediFlow Team

# ---- File Storage ----

UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ---- OCR ----

TESSERACT_PATH=/usr/bin/tesseract

# ---- Server ----

PORT=8000
