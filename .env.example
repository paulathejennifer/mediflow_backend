# ============================================================
# MediFlow Backend - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Required ----

# PostgreSQL connection string
DATABASE_URL=postgresql://mediflow:your_password@localhost:5432/mediflow

# Secret key for JWT token signing (generate a strong random key)
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-secret-key

# ---- Environment ----

# "development" or "production"
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins
# In production, set this to your frontend URL(s)
ALLOWED_HOSTS=["http://localhost:3000","http://localhost:8000"]

# ---- AI Services ----

# Groq API key for Llama 3.1 text AI (referral summaries, risk assessment)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI API key (optional)
OPENAI_API_KEY=

# ---- Email (SMTP) ----

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@mediflow.com
SMTP_FROM_NAME=MediFlow
SMTP_USE_TLS=true

# ---- Frontend ----

FRONTEND_URL=http://localhost:3000

# ---- Auth ----

REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- File Storage ----

UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ---- OCR ----

TESSERACT_PATH=/usr/bin/tesseract

# ---- Server ----

PORT=8000
